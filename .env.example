# =========================================
# Cherry-Social — Environment Variables
# © Cherry Computer Ltd. 2024
# =========================================
# Copy this file to .env and fill in your values.
# DO NOT commit your .env file to version control!

# ── Application ──
APP_PORT=3000
APP_ENV=development
APP_SECRET=change_me_to_a_random_secret_string
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://user:password@localhost:5432/cherrysocial

# ── Cache (Redis) ──
REDIS_URL=redis://localhost:6379

# ── GitHub OAuth ──
# Create an OAuth App at: https://github.com/settings/applications/new
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── JWT Authentication ──
JWT_SECRET=change_me_to_a_secure_jwt_secret
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@cherry-social.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Cherry-Social <noreply@cherry-social.com>"

# ── Storage (AWS S3 or compatible) ──
S3_BUCKET=cherry-social-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key

# ── Monitoring ──
SENTRY_DSN=your_sentry_dsn_here
